# Configuration for codespell (https://github.com/codespell-project/codespell),
# used by the "Codespell" workflow in .github/workflows/codespell.yml.
# Both this file and the path below are resolved relative to the working
# directory codespell runs in, so codespell must be started from the repository
# root (which is what the workflow does).
[codespell]
# Words that codespell must not report. The list is a baseline of the
# vocabulary that is already present in this repository: domain specific terms,
# identifiers, abbreviations, proper names and misspellings that cannot be
# corrected without breaking existing APIs, generated code or third party
# sources. Newly introduced misspellings that are not on the list are reported,
# and words should be removed from the list once the last occurrence of a
# misspelling in the repository has been fixed.
ignore-words = .codespell-ignore-words.txt
